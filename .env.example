# Copie ce fichier en .env et remplis les valeurs
# NE JAMAIS committer le fichier .env sur GitHub !

# Clé API Anthropic — récupère-la sur console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-XXXX-ta-cle-ici

# URL de la base de données Railway PostgreSQL
# Railway te la donne automatiquement quand tu ajoutes une DB
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Port local (Railway le gère automatiquement en production)
PORT=3000
